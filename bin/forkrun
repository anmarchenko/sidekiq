#!/usr/bin/env ruby
# frozen_string_literal: true

require "minitest"
require "uri"

# This runner invokes Minitest explicitly. Do not run it again at process exit.
def Minitest.autorun
end

require_relative "../test/helper"

require "datadog/ci"

# this is the monkey patch needed to prevent minitest instrumentation from starting and stopping test session for every test file
module Datadog
  module CI
    module Contrib
      module Minitest
        module Runner
          module ClassMethods
            def init_plugins(*args)
              super
            end
          end
        end
      end
    end
  end
end

module Datadog
  module CI
    module Contrib
      module Minitest
        module Reporter
          module InstanceMethods
            def report(*args)
              super
            end
          end
        end
      end
    end
  end
end

# normal Datadog configuration
Datadog.configure do |c|
  c.ci.enabled = true
  c.ci.agentless_mode_enabled = true
  c.env = 'ci'
  c.ci.instrument :minitest
end

# we start test session and test module here using datadog-ci's public API
test_session = Datadog::CI.start_test_session(
  tags: {
    Datadog::CI::Ext::Test::TAG_FRAMEWORK => Datadog::CI::Contrib::Minitest::Ext::FRAMEWORK,
    Datadog::CI::Ext::Test::TAG_FRAMEWORK_VERSION => Minitest::VERSION
  }
)
test_module = Datadog::CI.start_test_module(Datadog::CI::Contrib::Minitest::Ext::FRAMEWORK)

test_files = [
  "test/api_test.rb",
  "test/client_test.rb",
  "test/fetch_test.rb",
  "test/manager_test.rb",
  "test/processor_test.rb"
]
pids = []
redis_url = URI(ENV.fetch("REDIS_URL"))
unless ["redis", "rediss"].include?(redis_url.scheme)
  abort "forkrun requires a dedicated Redis server with a redis:// or rediss:// URL"
end

# Each worker owns one logical database on the dedicated test Redis server.
test_files.each_with_index do |test_file, worker_index|
  puts "Running tests in #{test_file}..."

  pid = fork do
    worker_redis_url = redis_url.dup
    worker_redis_url.path = "/#{worker_index}"
    ENV["REDIS_URL"] = worker_redis_url.to_s
    ENV["SIDEKIQ_FORKRUN_WORKER"] = worker_index.to_s
    require_relative "../#{test_file}"

    res = Minitest.run([])

    puts "Completed tests in #{test_file}"
    puts "-" * 50

    # ATTENTION: this is needed to mark test session as failed
    exit(1) if !res
  end

  pids << pid
end

failed = false
pids.each do |pid|
  status = Process.wait2(pid)[1]

  # ATTENTION: this is needed to mark test session as failed
  if status.exitstatus != 0
    failed = true
  end
end

puts "All test files completed!"

# here we mark test session and test module as passed or failed and finish them
if failed
  p "test session failed!!"
  test_module.failed!
  test_session.failed!
else
  p "test session passed!"
  test_module.passed!
  test_session.passed!
end

test_module.finish
test_session.finish
exit(failed ? 1 : 0)
