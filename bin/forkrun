#!/usr/bin/env ruby
# frozen_string_literal: true

require "minitest"
require_relative "../test/helper"

require "datadog/ci"

module Datadog
  module CI
    module Contrib
      module Minitest
        module Runner
          module ClassMethods
            def init_plugins(*args)
              super
            end
          end
        end
      end
    end
  end
end

module Datadog
  module CI
    module Contrib
      module Minitest
        module Reporter
          module InstanceMethods
            def report(*args)
              super
            end
          end
        end
      end
    end
  end
end

Datadog.configure do |c|
  c.ci.enabled = true
  c.ci.agentless_mode_enabled = true
  c.env = 'ci'
  c.ci.instrument :minitest
end

test_session = Datadog::CI.start_test_session(
  tags: {
    Datadog::CI::Ext::Test::TAG_FRAMEWORK => Datadog::CI::Contrib::Minitest::Ext::FRAMEWORK,
    Datadog::CI::Ext::Test::TAG_FRAMEWORK_VERSION => Minitest::VERSION
  }
)
test_module = Datadog::CI.start_test_module(Datadog::CI::Contrib::Minitest::Ext::FRAMEWORK)

# Get test files from the test directory
test_files = [
  "test/api_test.rb",
  "test/client_test.rb",
  "test/fetch_test.rb",
  "test/manager_test.rb",
  "test/processor_test.rb"
]
pids = []

# Iterate over each test file and run Minitest
test_files.each do |test_file|
  puts "Running tests in #{test_file}..."

  # Fork a process for each test file
  pid = fork do
    # Load the test file
    require_relative "../#{test_file}"

    # Run Minitest for this file
    res = Minitest.run([])

    puts "Completed tests in #{test_file}"
    puts "-" * 50

    exit(1) if !res
  end

  pids << pid
end

failed = false
pids.each do |pid|
  status = Process.wait2(pid)[1]

  if status.exitstatus != 0
    failed = true
  end
end

puts "All test files completed!"

if failed
  p "test session failed!!"
  test_module.failed!
  test_session.failed!
else
  p "test session passed!"
  test_module.passed!
  test_session.passed!
end

test_module.finish
test_session.finish
