#!/usr/bin/env ruby
# frozen_string_literal: true

require "minitest"
require_relative "../test/helper"

require "datadog/ci"

test_session = Datadog::CI.start_test_session(
  tags: {
    Datadog::CI::Ext::Test::TAG_FRAMEWORK => Datadog::CI::Contrib::Minitest::Ext::FRAMEWORK,
    Datadog::CI::Ext::Test::TAG_FRAMEWORK_VERSION => "1.0.0"
  }
)


# Get test files from the test directory
test_files = [
  "test/api_test.rb",
  "test/client_test.rb",
  "test/fetch_test.rb",
  "test/manager_test.rb",
  "test/processor_test.rb"
]
pids = []

# Iterate over each test file and run Minitest
test_files.each do |test_file|
  puts "Running tests in #{test_file}..."

  # Fork a process for each test file
  pid = fork do
    # Load the test file
    require_relative "../#{test_file}"

    # Run Minitest for this file
    Minitest.run([])

    puts "Completed tests in #{test_file}"
    puts "-" * 50
  end

  pids << pid
end

pids.each do |pid|
  Process.wait(pid)
end

puts "All test files completed!"

test_session.finish
